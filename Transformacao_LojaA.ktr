      <field_name>motivo</field_name>
      <formula_string>marca == null || marca.trim().isEmpty() ? "Marca nula" : (modelo == null || modelo.trim().isEmpty() ? "Modelo nulo" : (quantidade == null ? "Quantidade nula" : (quantidade &lt; 0 ? "Quantidade negativa" : "OK")))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
