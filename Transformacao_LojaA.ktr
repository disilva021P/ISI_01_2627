      <formula_string>marca != null ? marca.trim().toUpperCase() : ""</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field />
    </formula>
    <formula>
      <field_name>dispositivo</field_name>
      <formula_string>modelo != null ? modelo.trim().toUpperCase().replaceAll("(?i)" + marca.trim(), "").trim() : ""</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field />
