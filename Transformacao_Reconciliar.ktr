    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>preco_eur</field_name>
      <formula_string>preco_usd != null ? Double.valueOf(Math.round(preco_usd.doubleValue() * taxa_cambio.doubleValue() * 100.0) / 100.0) : null</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1700</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Renomear A</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>codigoProduto</name>
        <rename>id_a</rename>
      </field>
      <field>
        <name>nomeMarca</name>
        <rename>marca_a</rename>
      </field>
      <field>
        <name>dispositivo</name>
        <rename>modelo_a</rename>
      </field>
      <field>
        <name>unidades</name>
        <rename>unidades_a</rename>
      </field>
      <select_unspecified>Y</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>500</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Renomear B</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>codigoProduto</name>
        <rename>id_b</rename>
      </field>
      <field>
        <name>nomeMarca</name>
        <rename>marca_b</rename>
      </field>
      <field>
        <name>dispositivo</name>
        <rename>modelo_b</rename>
      </field>
      <field>
        <name>unidades</name>
        <rename>unidades_b</rename>
      </field>
      <field>
        <name>precoUnitario</name>
        <rename>preco_usd</rename>
      </field>
      <field>
        <name>estado</name>
        <rename>estado_b</rename>
      </field>
      <select_unspecified>Y</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>500</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Taxa</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>taxa_cambio</field_name>
      <formula_string>taxa_txt != null &amp;&amp; !taxa_txt.contains("$") &amp;&amp; taxa_txt.trim().length() > 0 ? Double.parseDouble(taxa_txt.replace(",", ".")) : 0.90</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1500</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Unir A e B</name>
    <type>MergeJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <join_type>FULL OUTER</join_type>
    <step1>Ordenar A</step1>
    <step2>Ordenar B</step2>
    <keys_1>
      <key>chave_a</key>
    </keys_1>
    <keys_2>
      <key>chave_b</key>
    </keys_2>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>900</xloc>
      <yloc>180</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
