  <step>
    <name>Campos reconciliacao</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>chave</field_name>
      <formula_string>chave_a != null ? chave_a : chave_b</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tipo</field_name>
      <formula_string>id_a != null &amp;&amp; id_b != null ? "Exata" : (id_a != null ? "So TeleCompra" : "So AmeriMobile")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>marca_final</field_name>
      <formula_string>marca_b != null ? marca_b : marca_a</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>modelo_final</field_name>
      <formula_string>modelo_b != null ? modelo_b : modelo_a</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>unidades_total</field_name>
      <formula_string>(unidades_a == null ? 0L : unidades_a.longValue()) + (unidades_b == null ? 0L : unidades_b.longValue())</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>estado_produto</field_name>
      <formula_string>((unidades_a == null ? 0L : unidades_a.longValue()) + (unidades_b == null ? 0L : unidades_b.longValue())) == 0L ? "Esgotado" : "Disponivel"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>ano_valido</field_name>
      <formula_string>anoLancamento != null &amp;&amp; anoLancamento.longValue() >= 1990L &amp;&amp; anoLancamento.longValue() &lt;= 2026L ? anoLancamento : null</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>ano_aviso</field_name>
      <formula_string>anoLancamento != null &amp;&amp; (anoLancamento.longValue() &lt; 1990L || anoLancamento.longValue() > 2026L) ? "Ano invalido" : null</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
