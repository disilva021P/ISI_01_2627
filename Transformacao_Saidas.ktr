yaml += "\n  sistemaOperativo: " + q(sistemaOperativo);
yaml += "\n  ano_valido: " + q(ano_valido);
yaml += "\n  preco_usd: " + q(preco_usd);
yaml += "\n  preco_eur: " + q(preco_eur);
yaml += "\n  ram_gb: " + q(ram_gb);
yaml += "\n  armazenamento_gb: " + q(armazenamento_gb);
yaml += "\n  bateria_mah: " + q(bateria_mah);
]]></jsScript_script></jsScript></jsScripts>
