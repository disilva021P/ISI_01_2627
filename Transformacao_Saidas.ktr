    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Principal</jsScript_name><jsScript_script><![CDATA[function q(v){ if(v==null) return "null"; var t=typeof v; if(t=="number"||t=="boolean") return String(v); return "\"" + String(v).replace(/\\/g,"\\\\").replace(/"/g,"\\\"") + "\""; }
var yaml = "- " + "chave: " + q(chave);
yaml += "\n  marca_final: " + q(marca_final);
yaml += "\n  modelo_final: " + q(modelo_final);
yaml += "\n  tipo: " + q(tipo);
yaml += "\n  id_a_md5: " + q(id_a_md5);
yaml += "\n  id_b_md5: " + q(id_b_md5);
yaml += "\n  unidades_total: " + q(unidades_total);
