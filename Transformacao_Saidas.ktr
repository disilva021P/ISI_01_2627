  <step>
    <name>Resumo execucao</name>
    <type>TableInput</type>
    <description>Taxa USD-&gt;EUR usada (coluna taxa_cambio) e nº de produtos com/sem especificações</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>bd_produtos_reconciliados</connection>
    <sql>SELECT ROUND(MAX(taxa_cambio),5) AS taxa_usd_eur,
 COUNT(*) AS total_produtos,
 SUM(CASE WHEN ram_gb IS NOT NULL OR armazenamento_gb IS NOT NULL OR bateria_mah IS NOT NULL THEN 1 ELSE 0 END) AS com_especificacoes,
 SUM(CASE WHEN ram_gb IS NULL AND armazenamento_gb IS NULL AND bateria_mah IS NULL THEN 1 ELSE 0 END) AS sem_especificacoes,
 DATE_FORMAT(NOW(),'%d/%m/%Y %H:%i') AS atualizado_em
FROM tb_produtos</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
