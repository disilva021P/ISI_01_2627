    <jsScripts><jsScript><jsScript_type>1</jsScript_type><jsScript_name>Inicio</jsScript_name><jsScript_script><![CDATA[var first = true;]]></jsScript_script></jsScript><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Principal</jsScript_name><jsScript_script><![CDATA[function s(v){ if(v==null) return "NULL"; if(typeof v=="number") return String(v); return "'" + String(v).replace(/\\/g,"\\\\").replace(/'/g,"''") + "'"; }
var sql = "";
if(first){ sql = "CREATE TABLE IF NOT EXISTS tb_produtos_anonimizado (chave VARCHAR(255), marca_final VARCHAR(100), modelo_final VARCHAR(255), tipo VARCHAR(50), id_a_md5 CHAR(32), id_b_md5 CHAR(32), unidades_total INT, estado_produto VARCHAR(50), sistemaOperativo VARCHAR(50), ano_valido INT, preco_usd DOUBLE, preco_eur DOUBLE, ram_gb INT, armazenamento_gb INT, bateria_mah INT);\n"; first = false; }
sql += "INSERT INTO tb_produtos_anonimizado (chave, marca_final, modelo_final, tipo, id_a_md5, id_b_md5, unidades_total, estado_produto, sistemaOperativo, ano_valido, preco_usd, preco_eur, ram_gb, armazenamento_gb, bateria_mah) VALUES (" + s(chave) + ", " + s(marca_final) + ", " + s(modelo_final) + ", " + s(tipo) + ", " + s(id_a_md5) + ", " + s(id_b_md5) + ", " + s(unidades_total) + ", " + s(estado_produto) + ", " + s(sistemaOperativo) + ", " + s(ano_valido) + ", " + s(preco_usd) + ", " + s(preco_eur) + ", " + s(ram_gb) + ", " + s(armazenamento_gb) + ", " + s(bateria_mah) + ");";
]]></jsScript_script></jsScript></jsScripts>
    <fields><field><name>sql</name><rename>sql</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
