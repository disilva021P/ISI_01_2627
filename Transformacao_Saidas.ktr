  <step>
    <name>SQL linhas</name>
    <type>ScriptValueMod</type>
    <description>Gera CREATE TABLE (1ª linha) e um INSERT por registo</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
