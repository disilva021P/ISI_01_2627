 {
  "id": "f2",
  "type": "function",
  "z": "t1",
  "name": "Lojas",
  "func": "const clean=r=>{const o={};for(const k in r)o[k.trim()]=r[k];return o};const num=v=>{const n=Number(String(v).replace(',','.'));return isNaN(n)?0:n};\nconst rows=(msg.payload||[]).map(clean);\nmsg.payload=rows.map(r=>({loja:r.loja,n_modelos:r.n_modelos,unidades_total:r.unidades_total,preco:(r.preco_medio_eur===''||r.preco_medio_eur===undefined)?'—':num(r.preco_medio_eur).toFixed(2)}));\nreturn msg;",
  "outputs": 1,
  "x": 700,
