  "type": "function",
  "z": "t1",
  "name": "Formatar MQTT",
  "func": "const p=typeof msg.payload==='object'?JSON.stringify(msg.payload):String(msg.payload);\nmsg.payload=new Date().toLocaleTimeString('pt-PT')+'  '+msg.topic+'  →  '+p.slice(0,120);\nreturn msg;",
