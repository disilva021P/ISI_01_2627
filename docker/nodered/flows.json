 {
  "id": "f1",
  "type": "function",
  "z": "t1",
  "name": "Marcas",
  "func": "const clean=r=>{const o={};for(const k in r)o[k.trim()]=r[k];return o};const num=v=>{const n=Number(String(v).replace(',','.'));return isNaN(n)?0:n};\nconst rows=(msg.payload||[]).map(clean);\nconst a=[{payload:[]}],b=[{payload:[]}];\nrows.forEach(r=>{a.push({topic:r.marca_final,payload:num(r.n_modelos)});b.push({topic:r.marca_final,payload:num(r.preco_medio_eur)});});\nreturn [a,b];",
  "outputs": 2,
  "x": 700,
  "y": 100,
  "wires": [
