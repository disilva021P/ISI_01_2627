  "width": "12",
  "height": "3",
  "format": "<table style=\"width:100%;text-align:left\"><tr><th>Loja</th><th>Modelos</th><th>Unidades</th><th>Preço médio (EUR)</th></tr><tr ng-repeat=\"r in msg.payload\"><td>{{r.loja}}</td><td>{{r.n_modelos}}</td><td>{{r.unidades_total}}</td><td>{{r.preco}}</td></tr></table>",
