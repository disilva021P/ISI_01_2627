 {
  "id": "f3",
  "type": "function",
  "z": "t1",
  "name": "Resumo",
  "func": "const clean=r=>{const o={};for(const k in r)o[k.trim()]=r[k];return o};\nconst r=clean((msg.payload||[])[0]||{});\nconst t=Number(String(r.taxa_usd_eur).replace(',','.'));\nmsg.payload={taxa:isNaN(t)?'n/d':t.toFixed(5),total:r.total_produtos,com:r.com_especificacoes,sem:r.sem_especificacoes,atualizado:r.atualizado_em};\nreturn msg;",
  "outputs": 1,
  "x": 700,
  "y": 340,
  "wires": [
   [
    "tr"
   ]
  ]
 },
 {
  "id": "tr",
  "type": "ui_template",
  "z": "t1",
  "group": "g1",
  "name": "Resumo da execução",
  "order": 1,
  "width": "12",
  "height": "2",
  "format": "<div style=\"display:flex;gap:32px;flex-wrap:wrap\"><div><b>Taxa USD→EUR usada</b><br><span style=\"font-size:28px\">{{msg.payload.taxa}}</span></div><div><b>Produtos reconciliados</b><br><span style=\"font-size:28px\">{{msg.payload.total}}</span></div><div><b>Com especificações</b><br><span style=\"font-size:28px\">{{msg.payload.com}}</span></div><div><b>Sem especificações</b><br><span style=\"font-size:28px\">{{msg.payload.sem}}</span></div></div><small>Atualizado: {{msg.payload.atualizado}}</small>",
  "storeOutMessages": true,
  "fwdInMessages": true,
  "resendOnRefresh": true,
  "templateScope": "local",
  "className": "",
